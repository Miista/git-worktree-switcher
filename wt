#!/usr/bin/env bash
set -e

# Switch between git worktrees with speed.

args=("$@")
VERSION="0.1.2"
TMP_PATH=$(mktemp)
BINARY_PATH=$(which wt)
JQ_URL="https://stedolan.github.io/jq/download"
RELEASE_URL="https://github.com/yankeexe/git-worktree-switcher/releases/latest"
RELEASE_API_URL="https://api.github.com/repos/yankeexe/git-worktree-switcher/releases/latest"


# Escape forward slash
arg=$(echo "${args[0]}" | sed 's/\//\\\//g')
is_interactive=false

for arg in "${args[@]}"; do
    if [[ "$arg" == "-i" ]]; then
		if command -v fzf &> /dev/null
		then is_interactive=true
		else
			echo "Error: fzf is not installed for interactive mode"
			echo "Install from: https://github.com/junegunn/fzf#installation"
			exit 1
		fi
        break
    fi
done

switch_worktree() {
	local name="$1"
	if [ -z "$name" ]; then
		echo "Usage: wt <worktree>"
		return 1
	fi
	local directory
	directory=$(git worktree list --porcelain | grep -E 'worktree ' | awk '/'"$(echo "$name" | sed 's/\//\\\//g')"'/ {print; exit}' | cut -d ' ' -f2-)
	if [ -z "$directory" ]; then
		echo "No worktree matching '$name' found."
		return 1
	fi
	echo "Changing to worktree at: $directory"
	cd "$directory"
	exec $SHELL
}

# show worktree list
worktree_list() {
	git worktree list
}

help_message() {
	echo -e "wt lets you switch between your git worktrees with speed.\n"
	echo "Usage:"
	echo -e "\twt: interactively select a worktree using fzf (default)."
	echo -e "\twt <worktree>: search for worktree names and change to that directory."
	echo -e "\twt -i: interactively select a worktree using fzf."
	echo -e "\twt list: list out all the git worktrees."
	echo -e "\twt update: update to the latest release of worktree switcher."
	echo -e "\twt version: show the CLI version."
	echo -e "\twt help: shows this help message."
	echo -e "\twt current: show the current worktree."
	echo -e "\twt add <branch> [--force]: add a new worktree for <branch> as a sibling folder."
	echo -e "\twt create <branch> [--force]: add a new worktree for <branch> and switch to it."
	echo -e "\twt rm <worktree> [--force]: remove the worktree matching <worktree>."
	echo -e "\twt done [worktree]: safely clean up a worktree after all changes are pushed."
	echo -e "\twt check [worktree]: show the status of safety checks for a worktree."
}

rm_worktree() {
	local name="$1"
	local force="$2"
	if [ -z "$name" ]; then
		echo "Usage: wt rm <branch-name> [--force]"
		return 1
	fi
	local match_path
	match_path=$(git worktree list --porcelain | awk -v name="$name" '
		/^worktree / { path = substr($0, 10) }
		/^branch /   { branch = substr($0, 8); sub("^refs/heads/", "", branch) }
		/^$/         { if (path ~ name || branch ~ name) { print path; exit } }
	')
	if [ -z "$match_path" ]; then
		echo "No worktree matching '$name' found."
		return 1
	fi
	local current_path
	current_path=$(pwd)
	if [[ "$current_path" == "$match_path" || "$current_path" == "$match_path/"* ]]; then
		echo "Cannot remove the current worktree. Switch to a different worktree first."
		return 1
	fi
	echo "Removing worktree at: $match_path"
	if [ "$force" == "--force" ]; then
		git worktree remove --force "$match_path"
	else
		git worktree remove "$match_path"
	fi
}

done_worktree() {
	local name=""
	local yes=false
	for arg in "$@"; do
		if [[ "$arg" == "--yes" ]]; then
			yes=true
		elif [ -z "$name" ]; then
			name="$arg"
		fi
	done
	local match_path match_branch
	if [ -z "$name" ]; then
		# no argument — use current worktree
		local current_path
		current_path=$(pwd)
		eval "$(git worktree list --porcelain | awk -v cwd="$current_path" '
			/^worktree / { path = substr($0, 10) }
			/^branch /   { branch = substr($0, 8); sub("^refs/heads/", "", branch) }
			/^$/         { if (cwd == path || index(cwd, path "/") == 1) { print "match_path=" path "\nmatch_branch=" branch; exit } }
		')"
		if [ -z "$match_path" ]; then
			echo "Not inside any known worktree."
			return 1
		fi
		name="$match_branch"
		# switch to main worktree before cleaning up
		local main_path
		main_path=$(git worktree list --porcelain | awk 'NR==1{print $2}')
		if [[ "$current_path" == "$main_path" || "$current_path" == "$main_path/"* ]]; then
			echo "Cannot clean up the main worktree."
			return 1
		fi
		echo "Switching to main worktree at: $main_path"
		cd "$main_path"
	else
		eval "$(git worktree list --porcelain | awk -v name="$name" '
			/^worktree / { path = substr($0, 10) }
			/^branch /   { branch = substr($0, 8); sub("^refs/heads/", "", branch) }
			/^$/         { if (path ~ name || branch ~ name) { print "match_path=" path "\nmatch_branch=" branch; exit } }
		')"
		if [ -z "$match_path" ]; then
			echo "No worktree matching '$name' found."
			return 1
		fi
		local current_path
		current_path=$(pwd)
		if [[ "$current_path" == "$match_path" || "$current_path" == "$match_path/"* ]]; then
			# in the target worktree — switch to main first
			local main_path
			main_path=$(git worktree list --porcelain | awk 'NR==1{print $2}')
			echo "Switching to main worktree at: $main_path"
			cd "$main_path"
		fi
	fi
	if [[ "$yes" == false ]]; then
		# check for uncommitted changes
		local status
		status=$(git -C "$match_path" status --porcelain)
		if [ -n "$status" ]; then
			echo "Worktree '$name' has uncommitted changes:"
			git -C "$match_path" status --short
			echo ""
			echo "Commit or stash your changes first, then run 'wt done $name' again."
			return 1
		fi
		# check for unpushed commits
		local upstream
		upstream=$(git -C "$match_path" rev-parse --abbrev-ref "@{upstream}" 2>/dev/null)
		if [ -n "$upstream" ]; then
			local unpushed
			unpushed=$(git -C "$match_path" log "$upstream..HEAD" --oneline)
			if [ -n "$unpushed" ]; then
				echo "Worktree '$name' has unpushed commits:"
				echo "$unpushed"
				echo ""
				echo "Push your changes first with 'git push', then run 'wt done $name' again."
				return 1
			fi
		else
			# no upstream set
			local main_branch
			main_branch=$(git -C "$match_path" rev-parse --abbrev-ref HEAD 2>/dev/null)
			echo "Branch '$main_branch' has no upstream tracking branch."
			echo "Push your branch first with 'git push -u origin $main_branch', then run 'wt done $name' again."
			return 1
		fi
	fi
	# all clean — remove worktree and delete branch
	echo "Removing worktree at: $match_path"
	if [[ "$yes" == true ]]; then
		git worktree remove --force "$match_path"
	else
		git worktree remove "$match_path"
	fi
	if [ $? -eq 0 ] && [ -n "$match_branch" ]; then
		echo "Deleting branch: $match_branch"
		if [[ "$yes" == true ]]; then
			git branch -D "$match_branch"
		else
			git branch -d "$match_branch"
		fi
	fi
}

check_worktree() {
	local name="$1"
	local match_path match_branch
	if [ -z "$name" ]; then
		local current_path
		current_path=$(pwd)
		eval "$(git worktree list --porcelain | awk -v cwd="$current_path" '
			/^worktree / { path = substr($0, 10) }
			/^branch /   { branch = substr($0, 8); sub("^refs/heads/", "", branch) }
			/^$/         { if (cwd == path || index(cwd, path "/") == 1) { print "match_path=" path "\nmatch_branch=" branch; exit } }
		')"
		if [ -z "$match_path" ]; then
			echo "Not inside any known worktree."
			return 1
		fi
		name="$match_branch"
	else
		eval "$(git worktree list --porcelain | awk -v name="$name" '
			/^worktree / { path = substr($0, 10) }
			/^branch /   { branch = substr($0, 8); sub("^refs/heads/", "", branch) }
			/^$/         { if (path ~ name || branch ~ name) { print "match_path=" path "\nmatch_branch=" branch; exit } }
		')"
		if [ -z "$match_path" ]; then
			echo "No worktree matching '$name' found."
			return 1
		fi
	fi

	echo "Checking worktree '$name' at: $match_path"
	echo ""
	local all_ok=true

	# Check 1: uncommitted changes
	local status
	status=$(git -C "$match_path" status --porcelain)
	if [ -n "$status" ]; then
		echo "  ✗ Has uncommitted changes"
		all_ok=false
	else
		echo "  ✓ No uncommitted changes"
	fi

	# Check 2: upstream tracking
	local upstream
	upstream=$(git -C "$match_path" rev-parse --abbrev-ref "@{upstream}" 2>/dev/null)
	if [ -z "$upstream" ]; then
		echo "  ✗ No upstream tracking branch"
		all_ok=false
	else
		echo "  ✓ Tracking $upstream"

		# Check 3: unpushed commits (only if upstream exists)
		local unpushed
		unpushed=$(git -C "$match_path" log "$upstream..HEAD" --oneline)
		if [ -n "$unpushed" ]; then
			echo "  ✗ Has unpushed commits"
			all_ok=false
		else
			echo "  ✓ No unpushed commits"
		fi
	fi

	echo ""
	if [[ "$all_ok" == true ]]; then
		echo "All checks passed. Ready for 'wt done $name'."
	else
		echo "Some checks failed. Resolve them before running 'wt done $name'."
		return 1
	fi
}

add_worktree() {
	local branch="$1"
	local force="$2"
	if [ -z "$branch" ]; then
		echo "Usage: wt add <branch-name> [--force]"
		return 1
	fi
	local main_path
	main_path=$(git worktree list --porcelain | awk 'NR==1{print $2}')
	local parent_path
	parent_path=$(dirname "$main_path")
	local worktree_path="$parent_path/$branch"
	echo "Adding worktree '$branch' at: $worktree_path"
	local force_flag=""
	[ "$force" == "--force" ] && force_flag="--force"
	local branch_exists=false
	git rev-parse --verify "$branch" &>/dev/null && branch_exists=true
	local remote_exists=false
	git rev-parse --verify "origin/$branch" &>/dev/null && remote_exists=true

	# 1. check for remote branch (use local if it already exists and tracks correctly)
	if [[ "$remote_exists" == true && "$branch_exists" == true ]]; then
		local upstream
		upstream=$(git config "branch.$branch.remote" 2>/dev/null)
		local merge_ref
		merge_ref=$(git config "branch.$branch.merge" 2>/dev/null)
		if [[ "$upstream" == "origin" && "$merge_ref" == "refs/heads/$branch" ]]; then
			git worktree add $force_flag "$worktree_path" "$branch" --quiet
		else
			echo "Local branch '$branch' exists but does not track 'origin/$branch'."
			if [ -n "$upstream" ] && [ -n "$merge_ref" ]; then
				echo "It currently tracks '$upstream/$(echo "$merge_ref" | sed 's|refs/heads/||')'."
			else
				echo "It has no upstream tracking branch configured."
			fi
			echo "Fix with: git branch --set-upstream-to=origin/$branch $branch"
			return 1
		fi
	elif [[ "$remote_exists" == true ]]; then
		git worktree add $force_flag --track -b "$branch" "$worktree_path" "origin/$branch" --quiet
	elif [[ "$branch_exists" == true ]]; then
		git worktree add $force_flag "$worktree_path" "$branch" --quiet
	else
		# 2. fetch and check for remote branch again
		git fetch --quiet
		if git rev-parse --verify "origin/$branch" &>/dev/null; then
			git worktree add $force_flag --track -b "$branch" "$worktree_path" "origin/$branch" --quiet
		# 3. create new local branch
		else
			git worktree add $force_flag -b "$branch" "$worktree_path" --quiet
		fi
	fi
}

create_worktree() {
	local branch="$1"
	local force="$2"
	if [ -z "$branch" ]; then
		echo "Usage: wt create <branch-name> [--force]"
		return 1
	fi
	add_worktree "$branch" "$force"
	if [ $? -eq 0 ]; then
		switch_worktree "$branch"
	fi
}

current_worktree() {
	current_path=$(pwd)
	main_worktree=""
	while IFS= read -r line; do
		case "$line" in
			worktree\ *)
				wt_path="${line#worktree }"
				;;
			branch\ *)
				branch="${line#branch refs/heads/}"
				;;
			"")
				if [[ "$current_path" == "$wt_path" || "$current_path" == "$wt_path/"* ]]; then
					echo "Current worktree: $wt_path [$branch]"
					return
				fi
				;;
		esac
	done < <(git worktree list --porcelain)
	echo "Not inside any known worktree."
}

goto_main_worktree() {
	main_worktree=$(git worktree list --porcelain | grep -E 'worktree ' | awk '{print $0; exit}' | cut -d ' ' -f2-)

	if [ -z "$main_worktree" ]; then
		:
	else
		echo Changing to main worktree at: "$main_worktree"
		cd "$main_worktree"
		exec $SHELL
	fi
}

download_latest_update() {
	download_url=$(curl -sL $RELEASE_API_URL | jq -r '.assets[0].browser_download_url')

	echo "Downloading latest version $fetched_tag_name"
	curl -sL -o "$TMP_PATH" "$download_url"

	echo "Updating to latest version..."
	chmod +x "$TMP_PATH"
	sudo mv "$TMP_PATH" "$BINARY_PATH"
	rm -f "$TMP_PATH"

	echo "You are using the latest version of worktree switcher: $fetched_tag_name"
}

check_release_version() {
	fetched_tag_name=$(curl -sL $RELEASE_API_URL | jq -r '.tag_name')

	if [ "$fetched_tag_name" == $VERSION ]; then
		echo "You have the latest version of worktree switcher!"
		echo "Version: $VERSION"
	else
		download_latest_update
	fi
}

update() {
	if [ -z "$(command -v jq)" ]; then
		echo "jq is required for updating worktree switcher via this command."
		echo -e "Install jq:\n$JQ_URL.\n"
		echo -e "Or visit:\n$RELEASE_URL"
	else
		check_release_version
	fi
}


if [ -z "${args[0]}" ]; then
	if command -v fzf &> /dev/null; then
		is_interactive=true
	else
		help_message
		exit 0
	fi
fi

case "${args[0]}" in
list)
	worktree_list
	;;
update)
	update
	;;
help|--help|-h)
	help_message
	;;
version)
	echo Version: $VERSION
	;;
-)
	goto_main_worktree
	;;
current)
	current_worktree
	;;
add)
	add_worktree "${args[1]}" "${args[2]}"
	;;
create)
	create_worktree "${args[1]}" "${args[2]}"
	;;
rm)
	rm_worktree "${args[1]}" "${args[2]}"
	;;
done)
	done_worktree "${args[1]}" "${args[2]}"
	;;
check)
	check_worktree "${args[1]}"
	;;
*)
	if [[ "$is_interactive" == true ]]; then
		directory=$(git worktree list --porcelain |
		awk '/worktree/ {wt=$2} /branch/ {sub("refs/heads/", "", $2); print wt " [" $2 "]"}' |
		fzf --query "" --height=10% --no-multi --exit-0 |
		awk '{print $1}')
		if [ -n "$directory" ]; then
			echo "Changing to worktree at: $directory"
			cd "$directory"
			exec $SHELL
		fi
	else
		switch_worktree "${args[0]}"
	fi
	;;
esac
